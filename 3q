+# Run the solution unit tests on every push and pull request.
+#
+# The tests need no Temporal server of their own: each solution directory's
+# conftest.py starts a throwaway one with WorkflowEnvironment.start_local(),
+# which downloads and caches the Temporal CLI binary on first use.
+#
+# run_tests.py runs one pytest process per solution directory. That is not a
+# nicety: the exercises import their modules by flat name, so a single pytest
+# process over the repo would import whichever directory it reached first and
+# hand those modules to the rest. See the README.
+name: Tests
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+jobs:
+  tests:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+
+      # Pinned to an exact release: setup-uv publishes no moving major tag
+      # above v7, so `@v10` does not resolve. Reads the interpreter version
+      # from .python-version, and caches downloads by default.
+      - name: Install uv
+        uses: astral-sh/setup-uv@v10.0.1
+
+      - name: Install dependencies
+        run: uv sync --locked
+
+      - name: Run solution tests
+        run: uv run python run_tests.py
