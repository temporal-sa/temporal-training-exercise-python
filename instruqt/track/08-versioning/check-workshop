#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone from the four files the attendee edits.
# Gate 2: the patch call and the new Activity are both present.
# Gate 3: both tests pass, including the replay test.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

cd /root/workshop || fail "Workshop directory is missing."
EX=exercise8

for f in banking_activities.py money_transfer_workflow.py start_worker.py test_money_transfer_workflow.py; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$f still has TODO comments. Implement them, then check again."
    fi
done
pass "All TODOs implemented"

if ! grep -q "send_notification" "$EX/banking_activities.py" 2>/dev/null; then
    fail "banking_activities.py has no send_notification Activity."
fi
pass "send_notification Activity defined"

if ! grep -q "workflow.patched" "$EX/money_transfer_workflow.py" 2>/dev/null; then
    fail "money_transfer_workflow.py never calls workflow.patched(). Without it the old histories will not replay."
fi
pass "workflow.patched() gates the new Activity"

if [ ! -f "$EX/workflow_history_v1.json" ]; then
    fail "exercise8/workflow_history_v1.json is missing. The replay test needs a pre-patch history."
fi
pass "Pre-patch history present"

# PYTHONPATH is needed: these test files import their modules by bare name.
if ! OUT=$(PYTHONPATH="$EX" timeout 300 uv run pytest "$EX/test_money_transfer_workflow.py" -q 2>&1); then
    echo "$OUT" | tail -25
    fail "The exercise8 tests did not pass. The replay test is the one that catches non-determinism."
fi
pass "Both tests pass, replay included"
echo "$OUT" | tail -3
